# Copy to .env and replace placeholder values. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=savenest
POSTGRES_USER=savenest
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# --- Backend (Spring Boot) ---
# JDBC URL used when running the backend outside Docker.
DATABASE_URL=jdbc:postgresql://localhost:5432/savenest
DATABASE_USERNAME=savenest
DATABASE_PASSWORD=replace-with-a-strong-local-password
# Must be true in any HTTPS deployment. false only for plain-http localhost dev.
COOKIE_SECURE=false
SESSION_TIMEOUT=7d
BCRYPT_STRENGTH=12
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=10

# --- Metadata worker ---
# Runs inside the backend by default. For a dedicated worker: run a second instance with
# WORKER_ENABLED=true and set WORKER_ENABLED=false on the web instance.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=5
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=30
WORKER_BACKOFF_MAX_SECONDS=3600

# --- Restricted outbound fetcher (SSRF limits) ---
FETCH_CONNECT_TIMEOUT_MS=4000
FETCH_READ_TIMEOUT_MS=8000
FETCH_TOTAL_TIMEOUT_MS=15000
FETCH_MAX_HTML_BYTES=1048576
FETCH_MAX_IMAGE_BYTES=2097152
FETCH_MAX_REDIRECTS=5
